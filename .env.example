# Salesforce OAuth (SSO-compatible)
# Create a Connected App in Salesforce Setup → App Manager → New Connected App
# Enable OAuth, add scopes: api, refresh_token, offline_access
# Set Callback URL: http://localhost:8000/api/auth/salesforce/callback
SF_OAUTH_CLIENT_ID=your-connected-app-consumer-key
SF_OAUTH_CLIENT_SECRET=your-connected-app-consumer-secret
SF_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/salesforce/callback
SF_DOMAIN=login   # 'login' for production, 'test' for sandbox

# NewsAPI
NEWS_API_KEY=

# RapidAPI (LinkedIn)
RAPIDAPI_KEY=
RAPIDAPI_LINKEDIN_HOST=fresh-linkedin-profile-data.p.rapidapi.com

# Crunchbase
CRUNCHBASE_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# SendGrid
SENDGRID_API_KEY=
DIGEST_RECIPIENT_EMAIL=you@youremail.com

# App
DATABASE_URL=sqlite:///./insight.db
API_KEY=changeme-secret-key
FRONTEND_URL=http://localhost:5173
